# Pocket Studio configuration. Copy to .env and fill in your own values.
# Never commit a file containing real credentials — .env is gitignored.

# --- Database (required) ----------------------------------------------------
# Any PostgreSQL connection string. Local development:
#   createdb pocket_studio
#   DATABASE_URL="postgresql://YOUR_USER@localhost:5432/pocket_studio?schema=public"
#
# Hosted Postgres (for example Neon) looks like:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
#
# On a serverless deployment this should be the POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Database, direct connection (optional) ---------------------------------
# Migrations take advisory locks and issue DDL, which a transaction-mode
# connection pooler does not reliably support, so they prefer an unpooled
# connection when one is available.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
#
# --- Managed Postgres attached through a platform integration ---------------
# Nothing needs to be copied by hand. When DATABASE_URL is not set, the app and
# the migration step read the variables the integration publishes itself, so the
# credentials the platform rotates are the ones actually used:
#
#   application  (pooled first)  DATABASE_URL, POSTGRES_PRISMA_URL,
#                                STORAGE_POSTGRES_PRISMA_URL, STORAGE_DATABASE_URL,
#                                STORAGE_POSTGRES_URL, then the unpooled ones
#   migrations   (direct first)  DIRECT_URL, DATABASE_URL_UNPOOLED,
#                                POSTGRES_URL_NON_POOLING,
#                                STORAGE_DATABASE_URL_UNPOOLED,
#                                STORAGE_POSTGRES_URL_NON_POOLING, then pooled
#
# The full lists live in src/lib/db/connection.ts and scripts/migrate-deploy.mjs.

# --- Uploads (optional) -----------------------------------------------------
# Largest audio file accepted, in megabytes. The default of 4 stays inside the
# request body limit of serverless platforms (Vercel's is 4.5 MB). Raise it if
# your deployment accepts larger bodies.
# POCKET_STUDIO_MAX_AUDIO_MB="4"
