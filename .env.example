# Pocket Studio configuration. Copy to .env and fill in your own values.
# Never commit a file containing real credentials — .env is gitignored.

# --- Database (required) ----------------------------------------------------
# Any PostgreSQL connection string. Local development:
#   createdb pocket_studio
#   DATABASE_URL="postgresql://YOUR_USER@localhost:5432/pocket_studio?schema=public"
#
# Hosted Postgres (for example Neon) looks like:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
#
# On a serverless deployment this should be the POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Database, direct connection (optional) ---------------------------------
# Migrations take advisory locks and issue DDL, which a transaction-mode
# connection pooler does not reliably support. If your provider gives you an
# unpooled connection string, set it here and the build will migrate over it.
# Neon's Vercel integration also exposes DATABASE_URL_UNPOOLED and
# POSTGRES_URL_NON_POOLING, either of which is picked up automatically.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Uploads (optional) -----------------------------------------------------
# Largest audio file accepted, in megabytes. The default of 4 stays inside the
# request body limit of serverless platforms (Vercel's is 4.5 MB). Raise it if
# your deployment accepts larger bodies.
# POCKET_STUDIO_MAX_AUDIO_MB="4"
